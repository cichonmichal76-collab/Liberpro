AddHandler application/x-httpd-php84 php

# ── LIBER PRO — .htaccess ──

# Strona 404
ErrorDocument 404 /404.html

# Jawne kodowanie odpowiedzi
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .json .xml
</IfModule>

# Wymuszenie HTTPS i hosta www
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Migracja starych adresow — 2026-10-25; tylko witryna liberpro.pl
    RewriteRule ^kalkulator-zus\.html$ https://www.liberpro.pl/narzedzia.html#kalkulator-zus [R=301,L,NE]
    RewriteRule ^kalkulator-kasa-fiskalna\.html$ https://www.liberpro.pl/narzedzia.html#kalkulator-kasa-fiskalna [R=301,L,NE]
    RewriteRule ^kalkulatory\.html$ https://www.liberpro.pl/narzedzia.html#kalkulator-vat [R=301,L,NE]
    RewriteRule ^kalkulatory-firmowe-2026\.html$ https://www.liberpro.pl/narzedzia.html#nowe-kalkulatory [R=301,L,NE]
    RewriteRule ^kalkulator-formy-opodatkowania-2026\.html$ https://www.liberpro.pl/narzedzia.html#kalkulator-formy-opodatkowania [R=301,L,NE]
    RewriteRule ^kalkulator-kosztu-pracownika-2026\.html$ https://www.liberpro.pl/narzedzia.html#kalkulator-kosztu-pracownika [R=301,L,NE]
    RewriteRule ^kalkulator-limitu-vat-2026\.html$ https://www.liberpro.pl/narzedzia.html#kalkulator-limitu-vat [R=301,L,NE]
    RewriteRule ^en/kalkulator-zus\.html$ https://www.liberpro.pl/en/narzedzia.html#kalkulator-zus [R=301,L,NE]
    RewriteRule ^en/kalkulator-kasa-fiskalna\.html$ https://www.liberpro.pl/en/narzedzia.html#kalkulator-kasa-fiskalna [R=301,L,NE]
    RewriteRule ^en/kalkulatory\.html$ https://www.liberpro.pl/en/narzedzia.html#kalkulator-vat [R=301,L,NE]
    RewriteRule ^en/tax-form-comparison-2026\.html$ https://www.liberpro.pl/en/narzedzia.html#kalkulator-formy-opodatkowania [R=301,L,NE]
    RewriteRule ^en/employee-cost-calculator-2026\.html$ https://www.liberpro.pl/en/narzedzia.html#kalkulator-kosztu-pracownika [R=301,L,NE]
    RewriteRule ^en/vat-exemption-limit-2026\.html$ https://www.liberpro.pl/en/narzedzia.html#kalkulator-limitu-vat [R=301,L,NE]
    RewriteRule ^en/blog-laczenie-danych-firmowych-z-ksiegowoscia\.html$ https://www.liberpro.pl/en/blog-combining-business-data-with-accounting.html [R=301,L,NE]

    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\.liberpro\.pl$ [NC]
    RewriteRule ^ https://www.liberpro.pl%{REQUEST_URI} [L,R=301]

    # Jeden adres dla strony głównej
    RewriteRule ^index\.html$ / [L,R=301]
    RewriteRule ^en/index\.html$ /en/ [L,R=301]

    # Jeden, bezpieczny adres ASCII dla zduplikowanego artykułu KSeF
    RewriteRule ^blog-odbiór-faktur-ksef\.html$ https://www.liberpro.pl/blog-odbior-faktur-ksef.html [L,R=301,NE]
    RewriteRule ^en/blog-odbiór-faktur-ksef\.html$ https://www.liberpro.pl/en/blog-odbior-faktur-ksef.html [L,R=301,NE]
</IfModule>

# Nagłówki bezpieczeństwa
<IfModule mod_headers.c>
    # Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # XSS (legacy)
    Header always set X-XSS-Protection "1; mode=block"
    # HSTS — wymusza HTTPS przez 1 rok
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # CSP — zezwala tylko na zasoby z własnej domeny + Google Fonts + własne skrypty
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net; frame-ancestors 'none'"
</IfModule>

# Blokada dostępu do wrażliwych plików
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokada odczytu pliku .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Ukryj wersję serwera
ServerSignature Off

# Cache dla statycznych plików
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        # Strony HTML mogą być używane z pamięci podręcznej przez 5 minut,
        # a następnie są ponownie sprawdzane przez przeglądarkę.
        Header set Cache-Control "public, max-age=300, must-revalidate"
        Header unset Pragma
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html              "access plus 5 minutes"
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png              "access plus 6 months"
    ExpiresByType image/webp             "access plus 6 months"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 month"
    ExpiresByType application/json      "access plus 0 seconds"
</IfModule>

# Wspólne pliki interfejsu zmieniają się razem z treścią stron.
# Przeglądarka ma je sprawdzać ponownie zamiast trzymać starą wersję miesiącami.
<IfModule mod_headers.c>
    <FilesMatch "^(site\.js|style\.css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Kompresja gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/json
</IfModule>

# Blokada indeksowania wrażliwych plików przez Google
<Files "contact.php">
    Header set X-Robots-Tag "noindex, nofollow"
</Files>
<Files "404.html">
    Header set X-Robots-Tag "noindex, nofollow"
</Files>
